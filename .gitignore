## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache files
.vs/
# Visual Studio 2019 cache files
.vs.slnx.sqlite

# Visual Studio 2022 cache files
.vs.sqlite

# Blend files
*.blsym
*.xap

# Resharper files
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode files
.JustCode

# TeamCity files
_TeamCity*

# DotCover files
*.dotCover

# NCrunch files
_NCrunch_*
.*crunch*.local.xml

# MightyMoose files
*.mm.*
AutoTest.Net/

# Web workbench files
.sass-cache/

# Installshield output folder
[Ii]nstall/

# Package files
*.nupkg
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Back up EPiServer packages.config files that are removed during update-package
*.packages.config.backup

# NuGet v3's project.lock.json
project.lock.json

# Microsoft Azure Tools
[Aa]zure[Pp]ublish[Pp]rofiles/
*.azurePubxml
*.pubxml
*.publishproj

# Visual Studio cache files
*.[Cc]ache
*.Cache
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pyd
*.pyc
*.sql
*.ntvs_analysis.dat
*.VC.db
*.VC.VC.opendb

# Visual Studio profiling files
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio test files
*.e2e
*.testsettings
*.testrunconfig

# App containers (UWP)
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Visual Studio code coverage files
*.coverage
*.coveragexml

# Precompiled headers
*.pch

# IDE Report files
*.rpt
*.failure.txt

# Build Model files
*.db*-shm
*.db*-wal
*.layout.JSON
*.json.layout

# Operations Manual files
*.cms

# Miscellaneous
*.tmp
*.bak
*.log
*.[Cc]hecked[Ii]n
*.pfx
*.pgc
*.pgd
*.publishsettings
*.vsix
*.vsixmanifest
VSIX/
*.DotSettings

# Visual Studio code format editor config
.editorconfig

# Other
Thumbs.db